{
  "name": "triana-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "report:validate": "node scripts/build-snapshot.mjs --validate data/labs-report.json",
    "dev": "next dev",
    "build": "npm run report:validate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:local": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
