#!/usr/bin/env python3
"""Local adapter seam: map authorized source records to PreviewTrace v1."""

from __future__ import annotations

import json
import sys
from typing import Any


def adapt_record(record: dict[str, Any]) -> dict[str, Any]:
    """Map one source record without inventing missing evidence."""
    raise NotImplementedError("Complete the customer-specific mapping")


def main() -> int:
    for line in sys.stdin:
        record = json.loads(line)
        if not isinstance(record, dict):
            raise TypeError("Every source record must be an object")
        print(json.dumps(adapt_record(record), separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
