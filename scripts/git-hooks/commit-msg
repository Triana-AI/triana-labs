#!/bin/sh

set -eu

message_file=$1
subject=$(sed -n '1p' "$message_file")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].+'; then
  printf '%s\n' "commit-msg: use Conventional Commits, for example: feat(records): add hash verification" >&2
  exit 1
fi

if [ "${#subject}" -gt 100 ]; then
  printf '%s\n' "commit-msg: keep the subject at 100 characters or fewer" >&2
  exit 1
fi
