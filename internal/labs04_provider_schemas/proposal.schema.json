      "required": [
        "opening_user_turn",
        "known_facts",
        "private_user_facts",
        "unknowns",
        "allowed_user_actions",
        "tool_world_constraints",
        "termination_conditions",
        "expected_tool_names",
        "stressor_codes"
      ],
      "type": "object"
    },
    "supportedTextDraft": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": ["OBSERVED", "GENERATED_VARIATION"],
          "type": "string"
        },
        "claim_keys": {"items": {"type": "string"}, "type": "array"},
        "text": {"type": "string"}
      },
      "required": ["text", "basis", "claim_keys"],
      "type": "object"
    },
    "turnPolicyDraft": {
      "additionalProperties": false,
      "properties": {
        "clarification_behavior": {
          "items": {"$ref": "#/$defs/supportedTextDraft"},
          "type": "array"
        },
        "escalation_tendencies": {
          "items": {"$ref": "#/$defs/supportedTextDraft"},
          "type": "array"
        },
        "forbidden_inventions": {
          "items": {"$ref": "#/$defs/supportedTextDraft"},
          "type": "array"
        },
        "grounding_claims": {
          "items": {"$ref": "#/$defs/claimDraft"},
          "type": "array"
        },
        "information_reveal_policy": {
          "items": {"$ref": "#/$defs/supportedTextDraft"},
          "type": "array"
        },
        "reaction_rules": {
          "items": {"$ref": "#/$defs/supportedTextDraft"},
          "type": "array"
        },
        "stop_conditions": {
          "items": {"$ref": "#/$defs/supportedTextDraft"},
          "type": "array"
        },
        "turn_policy_key": {"type": "string"}
      },
      "required": [
        "turn_policy_key",
        "information_reveal_policy",
        "reaction_rules",
        "clarification_behavior",
        "escalation_tendencies",
        "stop_conditions",
        "forbidden_inventions",
        "grounding_claims"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {"items": {"$ref": "#/$defs/caseDraft"}, "type": "array"},
    "intents": {"items": {"$ref": "#/$defs/intentDraft"}, "type": "array"},
    "personas": {"items": {"$ref": "#/$defs/personaDraft"}, "type": "array"},
    "turn_policies": {
      "items": {"$ref": "#/$defs/turnPolicyDraft"},
      "type": "array"
    }
  },
  "required": ["personas", "intents", "turn_policies", "cases"],
  "type": "object"
}
