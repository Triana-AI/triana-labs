  "$id": "https://schemas.triana.invalid/v1/protected_case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "$ref": "#/$defs/Approval"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$",
      "title": "Case Id",
      "type": "string"
    },
    "case_version": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Case Version",
      "type": "string"
    },
    "contract_kind": {
      "const": "protected_case",
      "title": "Contract Kind",
      "type": "string"
    },
    "evidence_requirements": {
      "items": {
        "discriminator": {
          "mapping": {
            "CUSTOMER_EVALUATOR": "#/$defs/EvaluatorEvidenceRequirement",
            "TRIANA_ASSERTION": "#/$defs/AssertionEvidenceRequirement"
          },
          "propertyName": "requirement_kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AssertionEvidenceRequirement"
          },
          {
            "$ref": "#/$defs/EvaluatorEvidenceRequirement"
          }
        ]
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence Requirements",
      "type": "array"
    },
    "fixture_contract": {
      "$ref": "#/$defs/FixtureContract"
    },
    "qualification": {
      "discriminator": {
        "mapping": {
          "NEEDS_FIXTURE": "#/$defs/NeedsFixtureQualification",
          "NOT_YET": "#/$defs/NotYetQualification",
          "READY": "#/$defs/ReadyQualification"
        },
        "propertyName": "qualification_state"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReadyQualification"
        },
        {
          "$ref": "#/$defs/NeedsFixtureQualification"
        },
        {
          "$ref": "#/$defs/NotYetQualification"
        }
      ],
      "title": "Qualification"
    },
    "release_obligation": {
      "$ref": "#/$defs/ReleaseObligation"
    },
    "replay_input": {
      "$ref": "#/$defs/ReplayInput"
    },
    "risk_name": {
      "title": "Risk Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Source Evidence",
      "type": "array"
    }
  },
  "required": [
    "contract_kind",
    "schema_version",
    "case_id",
    "risk_name",
    "source_evidence",
    "replay_input",
    "fixture_contract",
    "release_obligation",
    "evidence_requirements",
    "approval",
    "qualification",
    "case_version"
  ],
  "title": "ProtectedCase",
  "type": "object"
}
